{
  "manifest_version": 2,
  "name": "Insta DMs Only",
  "version": "1.2.0",
  "description": "Instagram: DMs only. Reddit: only threads opened from outside links, 5 minutes each.",
  "browser_specific_settings": {
    "gecko": {
      "id": "insta-dms-only@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "*://instagram.com/*",
    "*://*.instagram.com/*",
    "*://reddit.com/*",
    "*://*.reddit.com/*"
  ],
  "background": {
    "scripts": ["rules.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://instagram.com/*", "*://*.instagram.com/*"],
      "js": ["rules.js", "instagram.js"],
      "css": ["instagram.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["*://reddit.com/*", "*://*.reddit.com/*"],
      "js": ["rules.js", "reddit.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": ["blocked.html"]
}
