{
  "manifest_version": 2,
  "name": "Insta DMs Only",
  "version": "1.0.0",
  "description": "Blocks everything on Instagram except Direct Messages.",
  "browser_specific_settings": {
    "gecko": {
      "id": "insta-dms-only@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "*://instagram.com/*",
    "*://*.instagram.com/*"
  ],
  "background": {
    "scripts": ["rules.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://instagram.com/*", "*://*.instagram.com/*"],
      "js": ["rules.js", "content.js"],
      "css": ["hide.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
